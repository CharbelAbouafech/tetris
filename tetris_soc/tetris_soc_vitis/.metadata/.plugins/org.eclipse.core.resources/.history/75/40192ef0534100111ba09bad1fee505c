/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include "xparameters.h"
#include "xil_io.h"
#include "xil_printf.h"
#include "sleep.h"
#include <stdint.h>

#define TETRIS_BASEADDR XPAR_TOP_0_S00_AXI_BASEADDR

#define BOARD_ROWS 20
#define BOARD_COLS 10

static uint8_t board[BOARD_ROWS][BOARD_COLS];

static inline uint32_t cell_index(uint32_t row, uint32_t col)
{
    return row * BOARD_COLS + col;
}

static inline uint32_t cell_addr(uint32_t row, uint32_t col)
{
    return TETRIS_BASEADDR + (cell_index(row, col) * 4U);
}

static void write_cell(uint32_t row, uint32_t col, uint8_t tile)
{
    if (row >= BOARD_ROWS || col >= BOARD_COLS) {
        return;
    }

    board[row][col] = tile & 0x0F;
    Xil_Out32(cell_addr(row, col), (uint32_t)(tile & 0x0F));
}

static void clear_board(void)
{
    uint32_t r, c;

    for (r = 0; r < BOARD_ROWS; r++) {
        for (c = 0; c < BOARD_COLS; c++) {
            write_cell(r, c, 0);
        }
    }
}

static void fill_board(uint8_t tile)
{
    uint32_t r, c;

    for (r = 0; r < BOARD_ROWS; r++) {
        for (c = 0; c < BOARD_COLS; c++) {
            write_cell(r, c, tile);
        }
    }
}

static void draw_checkerboard(void)
{
    uint32_t r, c;

    for (r = 0; r < BOARD_ROWS; r++) {
        for (c = 0; c < BOARD_COLS; c++) {
            uint8_t tile = ((r + c) & 1U) ? 1 : 2;
            write_cell(r, c, tile);
        }
    }
}

static void draw_border(void)
{
    uint32_t r, c;

    clear_board();

    for (c = 0; c < BOARD_COLS; c++) {
        write_cell(0, c, 3);
        write_cell(BOARD_ROWS - 1, c, 3);
    }

    for (r = 0; r < BOARD_ROWS; r++) {
        write_cell(r, 0, 4);
        write_cell(r, BOARD_COLS - 1, 4);
    }
}

static void draw_test_pattern(void)
{
    clear_board();

    write_cell(0, 0, 1);
    write_cell(0, 1, 2);
    write_cell(0, 2, 3);
    write_cell(0, 3, 4);
    write_cell(0, 4, 5);
    write_cell(0, 5, 6);
    write_cell(0, 6, 7);

    write_cell(5, 4, 1);
    write_cell(6, 4, 1);
    write_cell(7, 4, 1);
    write_cell(7, 5, 1);

    write_cell(10, 2, 2);
    write_cell(10, 3, 2);
    write_cell(11, 3, 2);
    write_cell(11, 4, 2);

    write_cell(15, 7, 6);
    write_cell(16, 7, 6);
    write_cell(17, 7, 6);
    write_cell(18, 7, 6);
}

int main(void)
{
    xil_printf("Tetris PL AXI test start\r\n");
    xil_printf("Base address = 0x%08lx\r\n", (unsigned long)TETRIS_BASEADDR);

    clear_board();
    sleep(1);

    draw_test_pattern();
    sleep(2);

    draw_checkerboard();
    sleep(2);

    draw_border();
    sleep(2);

    fill_board(7);
    sleep(2);

    clear_board();
    xil_printf("Test complete\r\n");

    while (1) {
        sleep(1);
    }

    return 0;
}
